<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="io.github.zacharyzj.musicapp">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
    <application android:label="Music Player" android:icon="@drawable/player" android:allowBackup="false"
        android:theme="@android:style/Theme.Material.NoActionBar" android:extractNativeLibs="true">
        <activity android:name=".PlayerActivity" android:exported="true" android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|keyboard|density|uiMode">
            <meta-data android:name="android.app.lib_name" android:value="music_app_ui"/>
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <service android:name=".PlaybackService" android:exported="false" android:foregroundServiceType="mediaPlayback"/>
    </application>
</manifest>
