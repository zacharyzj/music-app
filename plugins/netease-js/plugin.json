{
  "id": "netease",
  "name": "网易云音乐",
  "version": "1.2.0+music.2",
  "description": "网易云曲库、歌单、歌词与扫码登录。播放和下载遵循网易云账号权限。",
  "main": "index.js",
  "capabilities": ["download"],
  "playback": "stream",
  "permissions": {
    "network": [
      "interfacepc.music.163.com",
      "music.163.com"
    ],
    "media": [
      "*.music.126.net",
      "*.music.163.com"
    ]
  },
  "navigation": [
    {
      "builtin": "home"
    },
    {
      "title": "每日推荐",
      "page": "daily"
    },
    {
      "title": "我的云盘",
      "page": "cloud"
    },
    {
      "builtin": "liked"
    },
    {
      "builtin": "playlists"
    },
    {
      "title": "排行榜",
      "page": "charts"
    },
    {
      "title": "热门歌单",
      "page": "playlists:全部:0"
    },
    {
      "title": "最新专辑",
      "page": "new-albums"
    },
    {
      "builtin": "savedAlbums"
    },
    {
      "builtin": "recent"
    }
  ],
  "settings": [
    {
      "key": "quality",
      "label": "音质",
      "type": "select",
      "default": "",
      "help": "优先使用所选音质，不可用时自动降低",
      "options": [
        {
          "value": "",
          "label": "跟随播放器"
        },
        {
          "value": "standard",
          "label": "标准"
        },
        {
          "value": "high",
          "label": "高音质"
        },
        {
          "value": "lossless",
          "label": "无损"
        },
        {
          "value": "hires",
          "label": "Hi-Res"
        }
      ]
    }
  ]
}
