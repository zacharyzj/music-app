import { Palette, LineEdit, ComboBox, Slider, ScrollView, CheckBox } from "std-widgets.slint";
export struct Row {resource:string,title:string,subtitle:string,album:string,duration:string,kind:string,cover:image,disabled:bool,show-video:bool,download-blocked:bool,download-label:string,download-hint:string,show-download:bool,account-actions:bool,liked:bool,like-pending:bool}
export struct PluginRow { name: string, permissions: string, enabled: bool }
export struct CatalogRow { title: string, description: string, permissions: string, action-label: string, can-install: bool }
export struct DownloadRow { title:string, artist:string, status:string, fraction:float, active:bool, failed:bool }
export struct Nav {title:string}
export enum PlayerMode { sequential, repeat-all, repeat-one, shuffle }
struct ModeAppearance { name: string, icon: image }
export global Theme {
    in-out property <bool> dark:true;
    out property <color> bg:dark ? #101014 : #f7f6fa;
    out property <color> panel:dark ? #1b1b23 : #ffffff;
    out property <color> elevated:dark ? #25252f : #eeeaf4;
    out property <color> ink:dark ? #f4f1fa : #24202e;
    out property <color> muted:dark ? #9491a4 : #80798b;
    out property <color> line:dark ? #ffffff0c : #201c3010;
    out property <color> accent:dark ? #d6b6fa : #7953ac;
    out property <color> on-accent:dark ? #292032 : #ffffff;
}
component IconButton inherits Rectangle {
    in property <image> icon;
    in property <bool> active;
    in property <bool> primary;
    in property <bool> enabled:true;
    callback clicked();
    width:36px;height:36px;border-radius:self.height/2;
    background:primary ? Theme.accent : touch.has-hover ? Theme.elevated : transparent;
    opacity:enabled ? 1 : 0.35;
    animate background {duration:140ms;}
    Image {source:root.icon;colorize:root.primary ? Theme.on-accent : root.active ? Theme.accent : Theme.ink;width:18px;height:18px;x:(parent.width - self.width)/2;y:(parent.height - self.height)/2;}
    touch:=TouchArea {enabled:root.enabled;mouse-cursor:pointer;clicked=>{root.clicked();}}
}
component ListIconButton inherits IconButton {
    in property <string> description;
    accessible-role: button;
    accessible-label: root.description;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    Tooltip { text: @markdown("\{root.description}"); }
}
enum PlayerModifier { none, ctrl, shift }
struct PlayerKey { modifier: PlayerModifier, key: string }
global PlayerKeys {
    public pure function label(binding: PlayerKey) -> string {
        let key = binding.key;
        let name = key == Key.LeftArrow ? "Left" : key == Key.RightArrow ? "Right"
            : key == Key.UpArrow ? "Up" : key == Key.DownArrow ? "Down"
            : key == Key.Space ? "Space" : key.to-uppercase();
        return (binding.modifier == PlayerModifier.ctrl ? "Ctrl + "
            : binding.modifier == PlayerModifier.shift ? "Shift + " : "") + name;
    }
}
component PlayerButton inherits IconButton {
    in property <string> label;
    in property <PlayerKey> shortcut;
    callback activated();
    forward-focus: button-focus;
    button-focus := FocusScope { width: 0px; height: 0px; focus-on-tab-navigation: false; }
    clicked => { button-focus.focus(); root.activated(); }
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    Tooltip { text: @markdown("\{root.label} (\{PlayerKeys.label(root.shortcut)})"); }

    public function handle-key(binding: PlayerKey, repeated: bool) -> bool {
        if binding != root.shortcut { return false; }
        if !repeated { root.activated(); }
        return true;
    }
}
component ActionButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    in property <bool> enabled:true;
    callback clicked();
    min-width:60px;preferred-width:label.preferred-width+30px;horizontal-stretch:0;
    height:34px;border-radius:10px;
    background:primary ? Theme.accent : touch.has-hover ? Theme.elevated.brighter(10%) : Theme.elevated;
    opacity:enabled ? 1 : 0.4;
    animate background {duration:140ms;}
    label:=Text {text:root.text;font-size:13px;font-weight:600;color:root.primary ? Theme.on-accent : Theme.ink;horizontal-alignment:center;vertical-alignment:center;}
    touch:=TouchArea {enabled:root.enabled;mouse-cursor:pointer;clicked=>{root.clicked();}}
}
component PageTab inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked();
    min-width:label.preferred-width;
    preferred-width:label.preferred-width;
    horizontal-stretch:0;
    height:38px;
    background:transparent;
    label:=Text {
        text:root.text;
        font-size:15px;
        font-weight:root.active ? 600 : 400;
        color:root.active ? Theme.ink : touch.has-hover ? Theme.ink : Theme.muted;
        y:2px;height:26px;
        vertical-alignment:center;
        animate color {duration:120ms;}
    }
    Rectangle {
        width:22px;height:3px;border-radius:1.5px;
        x:(parent.width - self.width)/2;y:parent.height - 4px;
        background:Theme.accent;
        opacity:root.active ? 1 : 0;
        animate opacity {duration:150ms;}
    }
    touch:=TouchArea {mouse-cursor:pointer;clicked=>{root.clicked();}}
}
component PageLink inherits Rectangle {
    in property <string> text;
    callback clicked();
    min-width:label.preferred-width;
    preferred-width:label.preferred-width;
    horizontal-stretch:0;
    height:30px;
    label:=Text {
        text:root.text;font-size:13px;
        color:touch.has-hover ? Theme.accent : Theme.muted;
        vertical-alignment:center;
        animate color {duration:120ms;}
    }
    touch:=TouchArea {mouse-cursor:pointer;clicked=>{root.clicked();}}
}
component Cover inherits Rectangle {
    in property <image> source;
    border-radius:12px;clip:true;background:@linear-gradient(135deg,#463a5c,#252a3e);
    Image {source:@image-url("icons/disc.svg");colorize:#ffffff20;width:parent.width*0.42;height:parent.height*0.42;x:(parent.width - self.width)/2;y:(parent.height - self.height)/2;}
    Image {source:root.source;image-fit:cover;width:parent.width;height:parent.height;}
}
component Glyph inherits Rectangle {
    in property <image> source;
    in property <color> tint:Theme.muted;
    width:18px;
    Image {source:root.source;colorize:root.tint;width:18px;height:18px;x:(parent.width - self.width)/2;y:(parent.height - self.height)/2;}
}
export component AppWindow inherits Window {
    title:"Music Player";icon:@image-url("icons/app.svg");
    out property <length> minimum-window-width:720px;
    out property <length> minimum-window-height:480px;
    preferred-width:1240px;preferred-height:820px;
    min-width:root.minimum-window-width;min-height:root.minimum-window-height;
    background:Theme.bg;default-font-family:"Microsoft YaHei UI";default-font-size:13px;
    out property <bool> compact:root.width<980px;
    private property <length> sidebar-width:root.compact ? 176px : 206px;
    private property <length> player-height:root.compact ? 96px : 110px;
    private property <length> actions-width: (root.compact ? 64px : 86px)
        + (root.page-has-video ? (root.compact ? 32px : 50px) : 0px)
        + (root.can-download ? (root.compact ? 80px : 88px) : 0px)
        + (root.page-account-actions ? (root.compact ? 64px : 100px) : 0px);
    private property <int> card-columns:root.compact ? 2 : 4;
    in-out property <bool> dark:true;
    callback native-theme-changed();
    init=>{Theme.dark=root.dark;Palette.color-scheme=root.dark?ColorScheme.dark:ColorScheme.light;}
    changed dark=>{Theme.dark=root.dark;Palette.color-scheme=root.dark?ColorScheme.dark:ColorScheme.light;root.native-theme-changed();}
    in property <[string]> sources;
    in property <[string]> suggestions;
    in property <bool> album-detail;
    in-out property <int> source-index;
    in-out property <int> nav-index:0;
    in property <[Nav]> nav;
    in property <[Nav]> page-links;
    in property <[Nav]> page-tabs;
    in property <int> page-tab-index:-1;
    in property <[Row]> rows;
    in property <[string]> online-sources;
    in-out property <int> online-index;
    in property <bool> search-page;
    in property <bool> can-download;
    in property <bool> page-has-video;
    in property <bool> anonymous-source;
    in property <bool> page-account-actions:true;
    in property <[DownloadRow]> downloads;
    in property <int> download-pending;
    in property <bool> can-filter;
    in-out property <bool> guest-only;
    in-out property <bool> show-downloads;
    callback download-action(int,string);
    callback filter-changed();
    in property <string> download-notice;
    private property <string> row-notice;
    notice-timer := Timer {
        interval: 4s; running: false;
        triggered => { root.row-notice = ""; self.stop(); }
    }
    public function notify-row(message: string) {
        root.row-notice = message;
        if notice-timer.running { notice-timer.restart(); } else { notice-timer.start(); }
    }
    callback online-source(int);
    in property <bool> cards;
    in property <bool> home-page;
    in property <bool> local-playlist;
    in property <[Row]> queue;
    in property <[PluginRow]> plugin-rows;
    in property <bool> has-quality-setting;
    in-out property <bool> show-catalog;
    in-out property <string> catalog-url;
    in property <string> catalog-status;
    in property <bool> catalog-busy;
    in property <[CatalogRow]> catalog-rows;
    callback catalog-action(int);
    in property <[string]> playlist-names;
    in-out property <int> playlist-index;
    in property <int> quality-index;
    in property <PlayerMode> playback-mode: sequential;
    private property <ModeAppearance> mode-appearance:
        root.playback-mode == PlayerMode.repeat-all ? { name: "列表循环", icon: @image-url("icons/repeat.svg") } :
        root.playback-mode == PlayerMode.repeat-one ? { name: "单曲循环", icon: @image-url("icons/repeat-one.svg") } :
        root.playback-mode == PlayerMode.shuffle ? { name: "随机播放", icon: @image-url("icons/shuffle.svg") } :
        { name: "顺序播放", icon: @image-url("icons/sequential.svg") };
    out property <string> playback-mode-name: root.mode-appearance.name;
    in property <string> heading:"本地音乐";
    in property <string> status:"添加音乐文件夹，开始聆听";
    in property <string> now-title:"还没有正在播放的歌曲";
    in property <string> now-artist;
    in property <image> now-cover;
    in property <string> lyric;
    in property <string> translated-lyric;
    in property <string> lyrics;
    in property <string> account-name:"登录";
    in property <bool> playing;
    in property <bool> busy;
    in property <bool> has-error;
    in property <bool> more;
    in property <string> next-label:"加载更多";
    in-out property <float> position;
    out property <bool> scrubbing;
    in property <float> duration;
    private property <float> last-audible-volume: 70;
    out property <float> volume-level: root.last-audible-volume;
    private property <PlayerKey> volume-up: { modifier: ctrl, key: Key.UpArrow };
    private property <PlayerKey> volume-down: { modifier: ctrl, key: Key.DownArrow };
    private property <PlayerKey> seek-back: { modifier: shift, key: Key.LeftArrow };
    private property <PlayerKey> seek-forward: { modifier: shift, key: Key.RightArrow };
    private property <PlayerKey> shuffle-shortcut: { modifier: ctrl, key: "s" };
    in property <string> time-label:"00:00 / 00:00";
    in property <image> qr;
    in property <string> login-message;
    in-out property <bool> show-login;
    in-out property <bool> show-queue;
    in-out property <bool> show-settings;
    in-out property <bool> show-lyrics;
    callback action(string);
    callback search(string,int);
    callback suggest(string);
    callback select-source(int);
    callback navigate(int);
    callback page-link(int);
    callback page-tab(int);
    callback row-action(int,string);
    callback queue-action(int,string);
    callback plugin-action(int,string);
    callback seek(float);
    callback volume(float);
    public function set-player-volume(value: float) {
        root.volume-level = clamp(value, 0, 100);
        if root.volume-level > 0 { root.last-audible-volume = root.volume-level; }
        root.volume(root.volume-level);
    }
    public function toggle-mute() {
        root.set-player-volume(root.volume-level > 0 ? 0 : root.last-audible-volume);
    }
    callback playlist-create(string);
    callback playlist-manage(string,string);
    callback quality(string);
    forward-focus:keyboard;
    keyboard:=FocusScope {
        // The native window owns the size. Content adapts inside it instead of
        // feeding its preferred/minimum sizes back into the window constraints.
        x:0px;y:0px;width:root.width;height:root.height;
        capture-key-pressed(event) => {
            if TextInputInterface.text-input-focused || root.show-catalog || root.show-login
                || event.modifiers.alt || event.modifiers.meta || (event.modifiers.control && event.modifiers.shift) {
                return reject;
            }
            let binding = { key: event.text.to-lowercase(), modifier: event.modifiers.control ? PlayerModifier.ctrl
                : event.modifiers.shift ? PlayerModifier.shift : PlayerModifier.none };
            if mode-button.handle-key(binding, event.repeat) || previous.handle-key(binding, event.repeat)
                || play-pause.handle-key(binding, event.repeat) || next-track.handle-key(binding, event.repeat)
                || queue-button.handle-key(binding, event.repeat) || lyrics-button.handle-key(binding, event.repeat)
                || mute.handle-key(binding, event.repeat) {
                return accept;
            }
            if binding == root.shuffle-shortcut {
                if !event.repeat { root.action("shuffle"); }
                return accept;
            }
            if binding.modifier == PlayerModifier.none && (event.text == Key.F7 || event.text == Key.F8) {
                if !event.repeat {
                    if event.text == Key.F7 { play-pause.activated(); } else { next-track.activated(); }
                }
                return accept;
            }
            if binding == root.volume-up || binding == root.volume-down {
                root.set-player-volume(root.volume-level + (binding == root.volume-up ? 10 : -10));
                return accept;
            }
            if binding == root.seek-back || binding == root.seek-forward {
                if root.duration > 0 {
                    root.seek(clamp(root.position + (binding == root.seek-forward ? 5 : -5), 0, root.duration));
                }
                return accept;
            }
            return reject;
        }
        VerticalLayout {spacing:0;
            HorizontalLayout {spacing:0;height:root.height - root.player-height;
                Rectangle {width:root.sidebar-width;background:Theme.dark ? #15151c : #eeebf3;
                    VerticalLayout {padding-top:root.compact ? 16px : 24px;padding-left:18px;padding-right:18px;padding-bottom:root.compact ? 12px : 16px;spacing:root.compact ? 8px : 12px;
                        HorizontalLayout {height:42px;spacing:10px;
                            Rectangle {width:34px;height:34px;border-radius:11px;background:Theme.accent;Image {source:@image-url("icons/disc.svg");colorize:#30233e;width:22px;height:22px;x:6px;y:6px;}}
                            Text {text:"MUSIC";font-weight:800;font-size:23px;color:Theme.ink;vertical-alignment:center;}
                        }
                        if !root.compact: Text {text:"听见你的日常";font-size:11px;color:Theme.muted;height:16px;}
                        ComboBox {model:root.sources;current-index<=>root.source-index;selected(v)=>{root.select-source(self.current-index);}}
                        if !root.compact: Text {text:"音乐空间";font-size:11px;color:Theme.muted;height:26px;vertical-alignment:bottom;}
                        ScrollView {min-height:0px;vertical-stretch:1;VerticalLayout {spacing:5px;
                            for n[i] in root.nav: Rectangle {height:36px;border-radius:10px;background:root.nav-index==i&&!root.show-settings ? (Theme.dark ? #d6b6fa18 : #7953ac18) : nav-touch.has-hover ? Theme.elevated : transparent;
                                HorizontalLayout {padding-left:12px;padding-right:10px;spacing:11px;
                                    Glyph {source:i==0 ? @image-url("icons/home.svg") : n.title=="每日推荐" ? @image-url("icons/disc.svg") : n.title=="喜欢的歌曲" ? @image-url("icons/heart.svg") : n.title=="我的云盘" ? @image-url("icons/cloud.svg") : @image-url("icons/queue.svg");tint:root.nav-index==i ? Theme.accent : Theme.muted;}
                                    Text {text:n.title;color:root.nav-index==i ? Theme.accent : Theme.ink;font-weight:root.nav-index==i?600:400;vertical-alignment:center;}
                                }
                                nav-touch:=TouchArea {mouse-cursor:pointer;clicked=>{root.show-lyrics=false;root.navigate(i);}}
                            }
                        }}
                        Rectangle {height:1px;background:Theme.line;}
                        Rectangle {height:36px;border-radius:10px;background:download-touch.has-hover||root.show-downloads ? Theme.elevated : transparent;
                            HorizontalLayout {padding-left:12px;spacing:11px;Glyph {source:@image-url("icons/cloud.svg");}
                                Text {text:root.download-pending>0 ? "下载队列 · "+root.download-pending : "下载队列";color:Theme.ink;vertical-alignment:center;}}
                            download-touch:=TouchArea {mouse-cursor:pointer;clicked=>{root.show-downloads=!root.show-downloads;root.show-queue=false;}}
                        }
                        Rectangle {height:root.compact ? 36px : 42px;border-radius:10px;background:settings-touch.has-hover||root.show-settings ? Theme.elevated : transparent;
                            HorizontalLayout {padding-left:12px;spacing:11px;Glyph {source:@image-url("icons/settings.svg");}Text {text:"设置与插件";color:Theme.ink;vertical-alignment:center;}}
                            settings-touch:=TouchArea {mouse-cursor:pointer;clicked=>{root.show-settings=!root.show-settings;}}
                        }
                        Rectangle {height:root.compact ? 40px : 45px;
                            HorizontalLayout {spacing:10px;
                                Rectangle {width:35px;height:35px;border-radius:18px;background:@linear-gradient(135deg,#c0a3df,#626d98);Image {source:@image-url("icons/user.svg");colorize:#ffffff;width:18px;height:18px;x:8px;y:7px;}}
                                VerticalLayout {alignment:center;spacing:2px;Text {text:root.source-index==0?"本地聆听":root.anonymous-source?"开放曲库":root.account-name;color:Theme.ink;font-size:12px;overflow:elide;min-width:0px;}Text {text:root.source-index==0?"音乐，从这里开始":root.anonymous-source?"免登录":"点击管理登录";color:Theme.muted;font-size:10px;}}
                            }
                            TouchArea {enabled:root.source-index>0&&!root.anonymous-source;mouse-cursor:pointer;clicked=>{root.action("login");}}
                        }
                    }
                }
                VerticalLayout {padding:root.compact ? 16px : 24px;spacing:root.compact ? 10px : 12px;min-width:0px;min-height:0px;horizontal-stretch:1;
                    HorizontalLayout {height:32px;spacing:12px;
                        if !root.compact: Text {min-width:0px;overflow:elide;text:root.source-index==0?"YOUR MUSIC LIBRARY":"MADE FOR YOUR MOMENTS";font-size:10px;color:Theme.muted;horizontal-stretch:1;vertical-alignment:center;}
                        if root.compact: Rectangle {horizontal-stretch:1;}
                        query:=LineEdit {width:245px;placeholder-text:"搜索音乐、专辑、歌手";edited=>{root.suggest(self.text);}accepted=>{root.search(self.text,kind.current-index);}}
                        kind:=ComboBox {width:92px;model:["歌曲","专辑","歌手","歌单"];}
                        IconButton {icon:@image-url("icons/search.svg");clicked=>{root.search(query.text,kind.current-index);}}
                    }
                    if root.suggestions.length>0: HorizontalLayout {spacing:8px;for suggestion in root.suggestions: ActionButton {text:suggestion;clicked=>{query.text=suggestion;root.search(suggestion,kind.current-index);}}}
                    HorizontalLayout {height:42px;spacing:10px;
                        Text {text:root.show-settings?"偏好与扩展":root.show-lyrics?"正在聆听":root.heading;color:Theme.ink;font-size:root.compact ? 24px : 28px;font-weight:700;min-width:0px;overflow:elide;horizontal-stretch:1;vertical-alignment:center;}
                        if root.album-detail&&!root.show-settings: ActionButton {text:"收藏专辑";clicked=>{root.action("save-album");}}
                        if root.album-detail&&!root.show-settings: ActionButton {text:"取消收藏";clicked=>{root.action("unsave-album");}}
                        if !root.cards&&root.rows.length>0&&!root.show-settings&&!root.show-lyrics: ActionButton {text:"播放全部";primary:true;clicked=>{root.action("play-all");}}
                    }
                    if !root.home-page||root.busy||root.show-settings||root.has-error: Text {text:root.busy?"正在为你加载音乐…":root.has-error?root.status:root.show-settings?"选择你喜欢的方式，打造自己的音乐空间":root.status;color:root.has-error?#e6a3ae:Theme.muted;overflow:elide;min-width:0px;font-size:12px;height:18px;}
                    if root.show-settings: ScrollView {VerticalLayout {spacing:18px;
                        Rectangle {height:root.compact ? 208px : 160px;border-radius:16px;background:Theme.panel;VerticalLayout {padding:20px;spacing:14px;
                            Text {text:"音乐与外观";color:Theme.ink;font-size:17px;font-weight:600;}
                            HorizontalLayout {spacing:10px;ActionButton {text:"添加音乐目录";primary:true;clicked=>{root.action("add-folder");}}ActionButton {text:"重新扫描";clicked=>{root.action("scan");}}ActionButton {text:"取消扫描";clicked=>{root.action("cancel-scan");}}Rectangle{horizontal-stretch:1;}if !root.compact: CheckBox {text:"深色主题";checked<=>root.dark;}}
                            if root.compact: HorizontalLayout {Rectangle {horizontal-stretch:1;}CheckBox {text:"深色主题";checked<=>root.dark;}}
                            HorizontalLayout {spacing:12px;Text {text:"播放音质";color:Theme.muted;vertical-alignment:center;}ComboBox {width:150px;enabled:root.has-quality-setting;model:["跟随播放器","标准","高音质","无损","Hi-Res"];current-index:root.quality-index;selected(v)=>{root.quality(["follow","standard","high","lossless","hires"][self.current-index]);}}Rectangle{horizontal-stretch:1;}ActionButton {text:"退出当前账号";enabled:root.source-index>0&&!root.anonymous-source;clicked=>{root.action("logout");}}}
                        }}
                        Rectangle {height:125px + root.plugin-rows.length*110px;border-radius:16px;background:Theme.panel;VerticalLayout {padding:20px;spacing:14px;
                            HorizontalLayout {Text {text:"音乐源插件";color:Theme.ink;font-size:17px;font-weight:600;horizontal-stretch:1;}ActionButton {text:"导入本地 ZIP";clicked=>{root.action("import");}}ActionButton {text:"在线插件";primary:true;clicked=>{root.show-catalog=true;if root.catalog-rows.length==0 {root.catalog-action(-1);}}}}
                            Text {text:"安装兼容的音乐源，即可在左侧切换。账号数据在本机加密保存。";color:Theme.muted;font-size:12px;wrap:word-wrap;}
                            for plugin[i] in root.plugin-rows: Rectangle {
                                height:95px;border-radius:10px;
                                background:plugin.enabled ? Theme.accent.mix(Theme.elevated, 8%) : Theme.elevated;
                                border-width:1px;border-color:plugin.enabled ? Theme.accent.transparentize(55%) : Theme.line;
                                HorizontalLayout {padding:13px;spacing:10px;
                                    VerticalLayout {alignment:center;spacing:3px;horizontal-stretch:1;min-width:0px;
                                        Text {text:plugin.name;color:plugin.enabled ? Theme.accent : Theme.ink;font-size:14px;font-weight:600;overflow:elide;min-width:0px;}
                                        Text {text:plugin.permissions;color:Theme.ink.mix(Theme.muted, 22%);font-size:11px;wrap:word-wrap;overflow:elide;min-width:0px;}
                                    }
                                    VerticalLayout {alignment:center;horizontal-stretch:0;
                                        HorizontalLayout {spacing:10px;
                                            ActionButton {text:plugin.enabled ? "已启用" : "启用";primary:plugin.enabled;clicked=>{root.plugin-action(i,"toggle");}}
                                            ActionButton {text:"卸载";clicked=>{root.plugin-action(i,"remove");}}
                                        }
                                    }
                                }
                            }
                        }}
                        Rectangle {height:220px;border-radius:16px;background:Theme.panel;VerticalLayout {padding:20px;spacing:14px;
                            Text {text:"本地歌单";color:Theme.ink;font-size:17px;font-weight:600;}
                            HorizontalLayout {spacing:10px;pname:=LineEdit {placeholder-text:"输入新歌单名称";}ActionButton {text:"创建歌单";clicked=>{root.playlist-create(pname.text);pname.text="";}}}
                            Text {text:"歌曲行的 ＋ 会加入下方选中的歌单或播放队列";color:Theme.muted;font-size:12px;}
                            ComboBox {model:root.playlist-names;current-index<=>root.playlist-index;}
                            HorizontalLayout {spacing:10px;ActionButton {text:"重命名选中歌单";clicked=>{root.playlist-manage(pname.text,"renamePlaylist");}}ActionButton {text:"删除选中歌单";clicked=>{root.playlist-manage("","deletePlaylist");}}Rectangle{horizontal-stretch:1;}}
                        }}
                    }}
                    if !root.show-settings&&!root.show-lyrics: VerticalLayout {spacing:root.compact ? 10px : 16px;min-height:0px;
                        if root.online-sources.length>0 && (root.online-sources.length>2 || root.can-filter): HorizontalLayout {
                            height:34px;spacing:10px;
                            if root.online-sources.length>2: ComboBox {width:156px;model:root.online-sources;current-index<=>root.online-index;selected(v)=>{root.online-source(self.current-index);}}
                            if root.can-filter: ActionButton {text:"仅看免登录可下载";primary:root.guest-only;clicked=>{root.guest-only=!root.guest-only;root.filter-changed();}}
                            Rectangle {horizontal-stretch:1;}
                        }
                        if root.page-tabs.length>0: HorizontalLayout {
                            height:38px;spacing:26px;
                            for tab[i] in root.page-tabs: PageTab {
                                text:tab.title;active:i==root.page-tab-index;
                                clicked=>{root.page-tab(i);}
                            }
                            Rectangle {horizontal-stretch:1;}
                        }
                        if root.page-links.length>0: HorizontalLayout {
                            height:30px;spacing:22px;
                            for link[i] in root.page-links: PageLink {
                                text:link.title=="上一页" ? "‹  上一页" : link.title=="下一页" ? "下一页  ›" : link.title;
                                clicked=>{root.page-link(i);}
                            }
                            Rectangle {horizontal-stretch:1;}
                        }
                        if root.rows.length==0&&!root.busy: Rectangle {border-radius:20px;background:Theme.panel;
                            VerticalLayout {x:0px;y:0px;width:parent.width;height:parent.height;alignment:center;padding:root.compact ? 16px : 50px;spacing:root.compact ? 12px : 18px;
                                HorizontalLayout {alignment:center;height:root.compact ? 48px : 64px;Image {source:@image-url("icons/disc.svg");colorize:Theme.accent;width:root.compact ? 48px : 64px;height:self.width;}}
                                Text {text:root.can-filter&&root.guest-only?"当前结果中没有免登录可下载的歌曲":root.search-page?"没有找到匹配结果":root.source-index==0?"把喜欢的音乐，留在身边。":"此刻，这里还很安静。";color:Theme.ink;font-size:root.compact ? 18px : 23px;font-weight:600;wrap:word-wrap;min-width:0px;horizontal-alignment:center;}
                                Text {text:root.can-filter&&root.guest-only?"可关闭筛选查看其他录音。":root.search-page?"试试其他曲名或歌手名。":root.source-index==0?"添加音乐文件夹，让每一张唱片都有自己的位置。":"试试搜索喜欢的音乐，或切换到其他页面。";color:Theme.muted;font-size:12px;wrap:word-wrap;min-width:0px;horizontal-alignment:center;}
                                HorizontalLayout {alignment:center;if root.more: ActionButton {text:root.next-label;clicked=>{root.action("more");}}if root.source-index==0&&!root.search-page: ActionButton {text:"添加音乐目录";primary:true;clicked=>{root.action("add-folder");}}}
                            }
                        }
                        if root.cards&&root.rows.length>0: cards-view:=ScrollView {content-width:self.width;VerticalLayout {spacing:22px;
                            if root.home-page: Rectangle {height:144px;border-radius:18px;clip:true;background:@linear-gradient(115deg,#302639,#20232f);
                                VerticalLayout {padding:20px;spacing:6px;Text {text:"A LITTLE MUSIC, A BETTER DAY";font-size:10px;color:#c6b6dc;}Text {text:"让音乐，填满此刻。";font-size:24px;font-weight:700;color:#f8f2ff;}Text {text:"发现新的旋律，也重逢熟悉的声音。";font-size:12px;color:#beb1c9;}HorizontalLayout {ActionButton {text:"探索歌单  →";primary:true;clicked=>{root.row-action(0,"open");}}Rectangle{horizontal-stretch:1;}}}
                                if !root.compact: Rectangle {for c in 3: Cover {source:root.rows[min(c,root.rows.length - 1)].cover;width:100px;height:100px;x:parent.width - 130px - c*56px;y:16px + c*6px;}}
                            }
                            for group in ((root.rows.length + root.card-columns - 1)/root.card-columns): HorizontalLayout {spacing:20px;
                                for col in root.card-columns: Rectangle {width:(cards-view.width - (root.card-columns - 1)*20px)/root.card-columns;height:self.width+66px;background:transparent;
                                    if (group*root.card-columns+col)<root.rows.length: VerticalLayout {spacing:10px;
                                        Cover {source:root.rows[group*root.card-columns+col].cover;height:self.width;border-radius:14px;
                                            if card-touch.has-hover: Rectangle {background:#20000000;IconButton {icon:@image-url("icons/play.svg");primary:true;x:parent.width - 48px;y:parent.height - 48px;width:36px;height:36px;clicked=>{root.row-action(group*root.card-columns+col,"open");}}}
                                        }
                                        Text {text:root.rows[group*root.card-columns+col].title;color:Theme.ink;font-size:14px;font-weight:600;overflow:elide;min-width:0px;}
                                        Text {text:root.rows[group*root.card-columns+col].subtitle;color:Theme.muted;font-size:11px;overflow:elide;min-width:0px;}
                                    }
                                    card-touch:=TouchArea {mouse-cursor:pointer;clicked=>{if (group*root.card-columns+col)<root.rows.length{root.row-action(group*root.card-columns+col,"open");}}}
                                }
                            }
                            if root.more: ActionButton {text:root.next-label;enabled:!root.busy;clicked=>{root.action("more");}}
                        }}
                        if !root.cards&&root.rows.length>0: VerticalLayout {spacing:6px;
                            HorizontalLayout {height:24px;padding-left:12px;padding-right:12px;spacing:root.compact ? 8px : 14px;Text {text:"#";width:25px;color:Theme.muted;font-size:11px;}Text {text:"歌曲 / 歌手";min-width:0px;horizontal-stretch:1;color:Theme.muted;font-size:11px;}if !root.compact: Text {text:"专辑";width:130px;color:Theme.muted;font-size:11px;}Text {text:"时长";width:48px;color:Theme.muted;font-size:11px;}Rectangle{width:root.actions-width;}}
                            ScrollView {VerticalLayout {spacing:4px;
                                for row[i] in root.rows: Rectangle {height:66px;border-radius:10px;background:row-touch.has-hover ? Theme.elevated : i/2==floor(i/2) ? Theme.panel.with-alpha(0.45) : transparent;
                                    row-touch:=TouchArea {
                                        x:0px;y:0px;width:max(0px,parent.width - root.actions-width - 10px);height:parent.height;
                                        enabled:!row.disabled;
                                        clicked=>{if row.kind != "track" {root.row-action(i,"open");}}
                                        double-clicked=>{if row.kind == "track" {root.row-action(i,"open");}}
                                    }
                                    HorizontalLayout {padding:10px;spacing:root.compact ? 8px : 14px;
                                        Text {text:(i+1);width:25px;color:Theme.muted;font-size:11px;vertical-alignment:center;}
                                        Cover {source:row.cover;width:44px;height:44px;border-radius:8px;}
                                        VerticalLayout {horizontal-stretch:1;alignment:center;spacing:5px;Text {text:row.title;color:row.disabled?Theme.muted:Theme.ink;font-size:14px;font-weight:500;overflow:elide;min-width:0px;}Text {text:row.subtitle;color:Theme.muted;font-size:11px;overflow:elide;min-width:0px;}}
                                        if !root.compact: Text {text:row.album;width:130px;color:Theme.muted;font-size:11px;overflow:elide;vertical-alignment:center;}
                                        Text {text:row.duration;width:48px;color:Theme.muted;font-size:11px;vertical-alignment:center;}
                                        HorizontalLayout {width:root.actions-width;spacing:root.compact ? 4px : 14px;alignment:end;
                                            ListIconButton {
                                                width:root.compact ? 28px : 36px;icon:@image-url("icons/play.svg");enabled:!row.disabled;
                                                description:row.kind != "track" ? "打开详情" : row.disabled ? "这首歌暂时无法播放" : "播放这首歌";
                                                clicked=>{root.row-action(i,"open");}
                                            }
                                            if row.show-video: ListIconButton {
                                                width:root.compact ? 28px : 36px;icon:@image-url("icons/video.svg");
                                                description:"看视频";enabled:!row.disabled;
                                                clicked=>{root.row-action(i,"video");}
                                            }
                                            if row.kind == "track": ListIconButton {
                                                width:root.compact ? 28px : 36px;icon:@image-url("icons/plus.svg");enabled:!row.disabled;
                                                description:row.disabled ? "这首歌暂时不可用" : row.resource.starts-with("local:") && root.playlist-index > 0 && root.playlist-index < root.playlist-names.length
                                                    ? "加入歌单「" + root.playlist-names[root.playlist-index] + "」" : "加入播放队列";
                                                clicked=>{root.row-action(i,"add");}
                                            }
                                            if row.show-download: ActionButton {
                                                width:74px;text:row.download-label;enabled:!row.download-blocked;
                                                accessible-role:button;accessible-label:row.download-hint;accessible-enabled:self.enabled;
                                                accessible-action-default=>{if self.enabled {root.row-action(i,"download");}}
                                                Tooltip {text:@markdown("\{row.download-hint}");}
                                                clicked=>{root.row-action(i,"download");}
                                            }
                                            if row.account-actions: ListIconButton {
                                                width:root.compact ? 28px : 36px;active:row.liked;enabled:!row.like-pending;
                                                icon:row.liked ? @image-url("icons/heart-filled.svg") : @image-url("icons/heart.svg");
                                                description:row.kind == "album" ? "收藏专辑" : row.like-pending ? "正在更新喜欢状态" : row.liked ? "取消喜欢" : "喜欢这首歌";
                                                clicked=>{root.row-action(i,row.liked ? "unlike" : "like");}
                                            }
                                            if row.account-actions: ListIconButton {
                                                width:root.compact ? 28px : 36px;icon:@image-url("icons/close.svg");
                                                enabled:root.local-playlist || row.kind == "album" || (row.liked && !row.like-pending);
                                                description:row.kind == "album" ? "取消收藏专辑" : root.local-playlist ? "从当前歌单移除" : row.like-pending ? "正在更新喜欢状态"
                                                    : row.liked ? "从喜欢的歌曲移除" : "这首歌还没加入喜欢";
                                                clicked=>{root.row-action(i,root.local-playlist ? "remove" : "unlike");}
                                            }
                                        }
                                    }
                                }
                                if root.more: ActionButton {text:root.next-label;enabled:!root.busy;clicked=>{root.action("more");}}
                            }}
                        }
                    }
                    if root.show-lyrics&&!root.show-settings: HorizontalLayout {spacing:root.compact ? 20px : 38px;
                        VerticalLayout {width:root.compact ? 140px : 240px;alignment:center;spacing:18px;Cover {source:root.now-cover;width:parent.width;height:self.width;border-radius:20px;}Text {text:root.now-title;color:Theme.ink;font-size:root.compact ? 16px : 20px;font-weight:600;wrap:word-wrap;}Text {text:root.now-artist;color:Theme.muted;wrap:word-wrap;}}
                        VerticalLayout {spacing:20px;Text {text:root.lyric==""?"让旋律先说话。":root.lyric;color:Theme.accent;font-size:26px;font-weight:600;wrap:word-wrap;min-height:80px;vertical-alignment:center;}Text {text:root.translated-lyric;color:Theme.muted;wrap:word-wrap;}ScrollView {VerticalLayout {Text {text:root.lyrics;color:Theme.muted;font-size:17px;wrap:word-wrap;vertical-alignment:top;}}}}
                    }
                }

            }
            Rectangle {height:root.player-height;background:Theme.dark ? #1b1b23 : #ffffff;
                HorizontalLayout {padding-left:root.compact ? 16px : 25px;padding-right:root.compact ? 16px : 25px;padding-top:root.compact ? 10px : 16px;padding-bottom:12px;spacing:root.compact ? 16px : 25px;
                    HorizontalLayout {width:root.compact ? 180px : 265px;spacing:root.compact ? 10px : 13px;Cover {source:root.now-cover;width:root.compact ? 48px : 62px;height:self.width;border-radius:12px;}VerticalLayout {alignment:center;spacing:6px;Text {text:root.now-title;color:Theme.ink;font-size:13px;font-weight:600;overflow:elide;min-width:0px;}Text {text:root.now-artist;color:Theme.muted;font-size:11px;overflow:elide;min-width:0px;}}}
                    VerticalLayout {horizontal-stretch:1;spacing:8px;
                        HorizontalLayout {alignment:center;spacing:root.compact ? 8px : 16px;height:42px;
                            mode-button := PlayerButton {
                                icon: root.mode-appearance.icon; active: root.playback-mode != PlayerMode.sequential;
                                label: root.playback-mode-name + " · 切换模式"; shortcut: { modifier: ctrl, key: "r" };
                                activated => { root.action("cycle-mode"); }
                            }
                            previous := PlayerButton {
                                icon: @image-url("icons/previous.svg");
                                label: "上一首"; shortcut: { modifier: ctrl, key: Key.LeftArrow };
                                activated => { root.action("previous"); }
                            }
                            play-pause := PlayerButton {
                                icon: root.playing ? @image-url("icons/pause.svg") : @image-url("icons/play.svg");
                                primary: true; width: 42px; height: 42px;
                                label: root.playing ? "暂停" : "播放"; shortcut: { modifier: none, key: Key.Space };
                                activated => { root.action("pause"); }
                            }
                            next-track := PlayerButton {
                                icon: @image-url("icons/next.svg");
                                label: "下一首"; shortcut: { modifier: ctrl, key: Key.RightArrow };
                                activated => { root.action("next"); }
                            }
                            queue-button := PlayerButton {
                                icon: @image-url("icons/queue.svg"); active: root.show-queue;
                                label: root.show-queue ? "关闭播放列表" : "打开播放列表"; shortcut: { modifier: ctrl, key: "p" };
                                activated => { root.show-queue = !root.show-queue; root.show-downloads = false; }
                            }
                        }
                        HorizontalLayout {spacing:12px;
                            Slider {
                                minimum: 0; maximum: root.duration > 0 ? root.duration : 1; value <=> root.position;
                                changed(_) => { root.scrubbing = true; }
                                released(v) => { root.scrubbing = false; root.seek(v); }
                                changed has-focus => { if !self.has-focus { root.scrubbing = false; } }
                                Tooltip { text: @markdown("后退 / 前进 5 秒 (\{PlayerKeys.label(root.seek-back)} / \{PlayerKeys.label(root.seek-forward)})"); }
                            }
                            Text {text:root.time-label;color:Theme.muted;font-size:10px;vertical-alignment:center;width:root.compact ? 78px : 100px;}
                        }
                    }
                    VerticalLayout {width:root.compact ? 172px : 220px;alignment:center;HorizontalLayout {height:36px;alignment:end;spacing:root.compact ? 4px : 8px;
                        lyrics-button := PlayerButton {
                            icon: @image-url("icons/lyrics.svg"); active: root.show-lyrics;
                            label: root.show-lyrics ? "关闭歌词" : "打开歌词"; shortcut: { modifier: ctrl, key: "l" };
                            activated => { root.show-lyrics = !root.show-lyrics; root.show-settings = false; }
                        }
                        mute := PlayerButton {
                            icon: root.volume-level > 0 ? @image-url("icons/volume.svg") : @image-url("icons/volume-muted.svg");
                            active: root.volume-level == 0;
                            label: root.volume-level > 0 ? "静音" : "取消静音"; shortcut: { modifier: ctrl, key: "m" };
                            activated => { root.toggle-mute(); }
                        }
                        Slider {
                            width: root.compact ? 52px : 85px; minimum: 0; maximum: 100; value <=> root.volume-level;
                            changed(v) => { root.set-player-volume(v); }
                            Tooltip { text: @markdown("音量 \{round(root.volume-level)}% (\{PlayerKeys.label(root.volume-down)} / \{PlayerKeys.label(root.volume-up)})"); }
                        }
                    }}
                }
            }
        }
        if root.show-queue: Rectangle {width:300px;height:parent.height - root.player-height;x:parent.width - self.width;y:0px;background:Theme.panel;
                        TouchArea {}
                        VerticalLayout {padding:18px;spacing:18px;HorizontalLayout {Text {text:"接下来播放";color:Theme.ink;font-size:18px;font-weight:600;horizontal-stretch:1;}ListIconButton {description:"关闭播放队列";icon:@image-url("icons/close.svg");clicked=>{root.show-queue=false;}}}Text{text:root.queue.length+" 首歌曲";color:Theme.muted;}
                            ScrollView {VerticalLayout {spacing:10px;padding-right:16px;for row[i] in root.queue: Rectangle {
                                height:54px;
                                HorizontalLayout {spacing:8px;
                                    Rectangle {horizontal-stretch:1;min-width:0px;
                                        HorizontalLayout {spacing:8px;
                                            Cover {source:row.cover;width:40px;height:40px;border-radius:7px;}
                                            Text {text:row.title;color:Theme.ink;font-size:12px;overflow:elide;min-width:0px;horizontal-stretch:1;vertical-alignment:center;}
                                        }
                                        TouchArea {enabled:!row.disabled;double-clicked=>{root.queue-action(i,"play");}}
                                    }
                                    ListIconButton {description:"播放这首歌";icon:@image-url("icons/play.svg");clicked=>{root.queue-action(i,"play");}}
                                    if row.show-video: ListIconButton {description:"看视频";icon:@image-url("icons/video.svg");enabled:!row.disabled;clicked=>{root.queue-action(i,"video");}}
                                    ListIconButton {description:"从播放队列移除";width:26px;icon:@image-url("icons/close.svg");clicked=>{root.queue-action(i,"remove");}}
                                }
                            }}}
                        }
                    }
        if root.show-downloads: Rectangle {
            width:min(380px, parent.width);height:parent.height - root.player-height;
            x:parent.width - self.width;y:0px;background:Theme.panel;border-width:1px;border-color:Theme.line;
            TouchArea {}
            VerticalLayout {padding:18px;spacing:12px;
                HorizontalLayout {height:36px;
                    Text {text:"下载队列";font-size:19px;font-weight:600;color:Theme.ink;horizontal-stretch:1;vertical-alignment:center;}
                    IconButton {icon:@image-url("icons/close.svg");clicked=>{root.show-downloads=false;}}
                }
                if root.downloads.length==0: Text {text:"暂无下载任务";color:Theme.muted;horizontal-alignment:center;vertical-alignment:center;vertical-stretch:1;}
                if root.downloads.length>0: ScrollView {VerticalLayout {alignment:start;spacing:8px;
                    for task[i] in root.downloads: Rectangle {height:task.failed ? 100px : 78px;border-radius:10px;background:Theme.elevated;
                        VerticalLayout {padding:10px;spacing:4px;
                            HorizontalLayout {spacing:6px;
                                VerticalLayout {horizontal-stretch:1;
                                    Text {text:task.title;font-size:14px;font-weight:600;color:Theme.ink;min-width:0px;overflow:elide;}
                                    Text {text:task.artist;font-size:11px;color:Theme.muted;min-width:0px;overflow:elide;}
                                }
                                if task.failed: ActionButton {text:"重试";clicked=>{root.download-action(i,"retry");}}
                                if !task.active: IconButton {width:26px;icon:@image-url("icons/close.svg");clicked=>{root.download-action(i,"remove");}}
                            }
                            Text {text:task.status;font-size:11px;color:task.failed ? #d98796 : Theme.muted;wrap:word-wrap;overflow:elide;min-width:0px;}
                            if task.active: Rectangle {height:3px;border-radius:2px;background:Theme.line;
                                Rectangle {height:parent.height;width:parent.width*task.fraction;border-radius:2px;background:Theme.accent;}
                            }
                        }
                    }
                }}
            }
        }
    }
    if root.row-notice != "": Rectangle {
        x:(parent.width - self.width)/2;y:parent.height - root.player-height - self.height - 12px;
        width:min(root.width - 40px, notice-text.preferred-width + 32px, 520px);
        height:notice-text.preferred-height + 18px;border-radius:10px;
        background:Theme.elevated;border-width:1px;border-color:Theme.muted.with-alpha(0.4);
        notice-text := Text {
            x:16px;width:parent.width - 32px;text:root.row-notice;color:Theme.ink;
            wrap:word-wrap;horizontal-alignment:center;vertical-alignment:center;
        }
    }
    if root.show-catalog: Rectangle {
        background:#88000000;TouchArea {}
        Rectangle {width:min(root.width - 48px, 650px);height:min(root.height - 48px, 610px);
            x:(parent.width - self.width)/2;y:(parent.height - self.height)/2;background:Theme.panel;border-radius:18px;
            VerticalLayout {padding:20px;spacing:12px;
                HorizontalLayout {Text {text:"在线插件";color:Theme.ink;font-size:20px;font-weight:600;horizontal-stretch:1;}IconButton {icon:@image-url("icons/close.svg");clicked=>{root.show-catalog=false;}}}
                Text {text:"插件索引或插件 ZIP 的 HTTPS 地址";color:Theme.muted;font-size:12px;}
                HorizontalLayout {spacing:8px;LineEdit {text<=>root.catalog-url;enabled:!root.catalog-busy;horizontal-stretch:1;accepted=>{root.catalog-action(-1);}}ActionButton {text:"读取 / 导入";enabled:!root.catalog-busy;clicked=>{root.catalog-action(-1);}}}
                Text {text:root.catalog-status;color:Theme.muted;wrap:word-wrap;font-size:12px;}
                ScrollView {VerticalLayout {spacing:8px;
                    for entry[i] in root.catalog-rows: Rectangle {height:98px;background:Theme.elevated;border-radius:10px;
                        HorizontalLayout {padding:12px;spacing:10px;
                            VerticalLayout {horizontal-stretch:1;min-width:0px;alignment:center;spacing:3px;
                                Text {text:entry.title;color:Theme.ink;font-weight:600;overflow:elide;min-width:0px;}
                                Text {text:entry.description;color:Theme.ink;font-size:12px;overflow:elide;min-width:0px;}
                                Text {text:entry.permissions;color:Theme.muted;font-size:10px;wrap:word-wrap;overflow:elide;min-width:0px;}
                            }
                            VerticalLayout {alignment:center;horizontal-stretch:0;ActionButton {text:entry.action-label;primary:entry.can-install;enabled:entry.can-install&&!root.catalog-busy;clicked=>{root.catalog-action(i);}}}
                        }
                    }
                    Rectangle {vertical-stretch:1;}
                }}
            }
        }
    }
    if root.show-login: Rectangle {background:#b0000000;
        TouchArea {}
        Rectangle {width:360px;height:450px;x:(parent.width - self.width)/2;y:(parent.height - self.height)/2;background:Theme.panel;border-radius:22px;
            VerticalLayout {padding:28px;spacing:20px;
                HorizontalLayout {Text {text:"连接你的音乐";color:Theme.ink;font-size:22px;font-weight:600;horizontal-stretch:1;}IconButton {icon:@image-url("icons/close.svg");clicked=>{root.action("cancel-login");}}}
                Rectangle {width:260px;height:260px;background:white;border-radius:12px;Image {source:root.qr;image-fit:contain;width:240px;height:240px;x:10px;y:10px;}}
                Text {text:root.login-message;color:Theme.muted;font-size:13px;wrap:word-wrap;horizontal-alignment:center;}
            }
        }
    }
}
